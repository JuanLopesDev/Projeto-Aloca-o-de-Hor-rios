@model ProjetoAlocacaoHorarios.Web.Models.ManagementViewModel
@{ ViewData["Title"] = "Professores"; }
<partial name="_ManagementAlerts" /><div class="section-head"><a asp-action="Index">← Cadastros</a><p class="eyebrow">PESSOAS</p><h1>Professores</h1><p>Ao cadastrar, o sistema cria também um acesso de professor.</p></div>
<div class="workspace-grid"><section class="form-card"><h2>Novo professor</h2><form asp-action="CreateTeacher" method="post"><label>Nome completo<input name="name" placeholder="Ex.: Ana Souza" required /></label><label>E-mail de acesso<input name="email" type="email" placeholder="ana@instituicao.edu.br" required /></label><label>Senha inicial<input name="password" value="Horario@2026" required /></label><button class="btn btn-primary">Criar professor</button></form></section><section class="list-card"><div class="list-title"><h2>Cadastrados</h2><span>@Model.Teachers.Count</span></div>@foreach(var item in Model.Teachers){<article class="person-row"><span class="avatar">@item.Name[0]</span><div><strong>@item.Name</strong><small>@(item.UserId is null ? "Perfil sem acesso" : "Acesso ativo")</small></div></article>}</section></div>
