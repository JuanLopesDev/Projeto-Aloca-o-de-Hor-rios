@model ProjetoAlocacaoHorarios.Web.Models.ManagementViewModel
@{ ViewData["Title"] = "Cursos"; }
<partial name="_ManagementAlerts" /><div class="section-head"><a asp-action="Index">← Cadastros</a><p class="eyebrow">ESTRUTURA ACADÊMICA</p><h1>Cursos</h1><p>Defina a formação a que as turmas pertencem.</p></div><div class="workspace-grid"><section class="form-card"><h2>Novo curso</h2><form asp-action="CreateCourse" method="post"><label>Nome do curso<input name="name" placeholder="Ex.: Análise e Desenvolvimento de Sistemas" required /></label><label>Nível de ensino<select name="educationLevel"><option>Graduação</option><option>Técnico</option><option>Ensino Médio</option><option>Pós-graduação</option></select></label><button class="btn btn-primary">Cadastrar curso</button></form></section><section class="list-card"><div class="list-title"><h2>Cursos cadastrados</h2><span>@Model.Courses.Count</span></div>@foreach(var item in Model.Courses){<article class="simple-row"><span>▣</span><div><strong>@item.Name</strong><small>@item.EducationLevel</small></div></article>}</section></div>
