@model ProjetoAlocacaoHorarios.Web.Models.ManagementViewModel
@{ ViewData["Title"] = "Alocações"; }
<partial name="_ManagementAlerts" /><div class="section-head"><a asp-action="Index">← Cadastros</a><p class="eyebrow">VÍNCULO DE AULAS</p><h1>Alocações</h1><p>Associe quem ensina, o que será ensinado e para qual turma.</p></div><section class="form-card wide-form"><h2>Nova alocação</h2>@if(!Model.Teachers.Any() || !Model.Classes.Any() || !Model.Subjects.Any()){<p class="form-hint">Cadastre pelo menos um professor, turma e disciplina antes.</p>}else{<form asp-action="CreateAssignment" method="post" class="form-row assignment-row"><label>Professor<select name="teacherId">@foreach(var x in Model.Teachers){<option value="@x.Id">@x.Name</option>}</select></label><label>Disciplina<select name="subjectId">@foreach(var x in Model.Subjects){<option value="@x.Id">@x.Name</option>}</select></label><label>Turma<select name="classGroupId">@foreach(var x in Model.Classes){<option value="@x.Id">@x.Name</option>}</select></label><label>Aulas semanais<input name="weeklyLessons" type="number" min="1" max="20" value="2"/></label><button class="btn btn-primary">Criar alocação</button></form>}</section><section class="list-card full-list"><div class="list-title"><h2>Alocações cadastradas</h2><span>@Model.Assignments.Count</span></div><div class="table-responsive"><table class="table modern-table"><thead><tr><th>Professor</th><th>Disciplina</th><th>Turma</th><th>Aulas/semana</th><th></th></tr></thead><tbody>@foreach(var item in Model.Assignments){<tr><td>@item.Teacher!.Name</td><td>@item.Subject!.Name</td><td>@item.ClassGroup!.Name</td><td>@item.WeeklyLessons</td><td><form asp-action="Delete" method="post"><input type="hidden" name="entity" value="assignment"/><input type="hidden" name="id" value="@item.Id"/><button class="link-danger">Remover</button></form></td></tr>}</tbody></table></div></section>
