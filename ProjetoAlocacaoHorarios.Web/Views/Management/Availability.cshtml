@model ProjetoAlocacaoHorarios.Web.Models.ManagementViewModel
@{ ViewData["Title"] = "Disponibilidade"; }
<partial name="_ManagementAlerts" /><div class="section-head"><a asp-action="Index">← Cadastros</a><p class="eyebrow">AGENDA DOCENTE</p><h1>Disponibilidade</h1><p>Marque cada horário em que o professor pode ministrar aulas.</p></div><div class="workspace-grid"><section class="form-card"><h2>Adicionar disponibilidade</h2>@if(!Model.Teachers.Any() || !Model.Slots.Any()){<p class="form-hint">É preciso ter professores e slots cadastrados antes.</p>}else{<form asp-action="CreateAvailability" method="post"><label>Professor<select name="teacherId">@foreach(var x in Model.Teachers){<option value="@x.Id">@x.Name</option>}</select></label><label>Horário disponível<select name="timeSlotId">@foreach(var x in Model.Slots){<option value="@x.Id">@x.Label</option>}</select></label><button class="btn btn-primary">Adicionar disponibilidade</button></form>}</section><section class="list-card"><div class="list-title"><h2>Disponibilidades</h2><span>@Model.Availabilities.Count</span></div>@foreach(var item in Model.Availabilities){<article class="simple-row"><span>✓</span><div><strong>@item.Teacher!.Name</strong><small>@item.TimeSlot!.Label</small></div><form asp-action="Delete" method="post"><input type="hidden" name="entity" value="availability"/><input type="hidden" name="id" value="@item.Id"/><button class="link-danger">Remover</button></form></article>}</section></div>
