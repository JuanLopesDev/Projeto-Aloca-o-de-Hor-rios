@model ProjetoAlocacaoHorarios.Web.Models.ManagementViewModel
@{ ViewData["Title"] = "Disciplinas"; }
<partial name="_ManagementAlerts" /><div class="section-head"><a asp-action="Index">← Cadastros</a><p class="eyebrow">COMPONENTES CURRICULARES</p><h1>Disciplinas</h1><p>Disciplinas podem ser reutilizadas em várias turmas.</p></div><div class="workspace-grid"><section class="form-card"><h2>Nova disciplina</h2><form asp-action="CreateSubject" method="post"><label>Nome da disciplina<input name="name" placeholder="Ex.: Banco de Dados" required /></label><button class="btn btn-primary">Cadastrar disciplina</button></form></section><section class="list-card"><div class="list-title"><h2>Disciplinas cadastradas</h2><span>@Model.Subjects.Count</span></div>@foreach(var item in Model.Subjects){<article class="simple-row"><span>◇</span><div><strong>@item.Name</strong><small>Componente curricular</small></div><form asp-action="Delete" method="post"><input type="hidden" name="entity" value="subject"/><input type="hidden" name="id" value="@item.Id"/><button class="link-danger">Remover</button></form></article>}</section></div>
