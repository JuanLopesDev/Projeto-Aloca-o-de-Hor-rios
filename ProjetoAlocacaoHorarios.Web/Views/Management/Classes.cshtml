@model ProjetoAlocacaoHorarios.Web.Models.ManagementViewModel
@{ ViewData["Title"] = "Turmas"; }
<partial name="_ManagementAlerts" /><div class="section-head"><a asp-action="Index">← Cadastros</a><p class="eyebrow">ESTRUTURA ACADÊMICA</p><h1>Turmas</h1><p>Uma turma pertence a um curso e possui seu próprio turno.</p></div><div class="workspace-grid"><section class="form-card"><h2>Nova turma</h2>@if(!Model.Courses.Any()){<p class="form-hint">Primeiro cadastre um curso.</p>}else{<form asp-action="CreateClass" method="post"><label>Curso<select name="courseId">@foreach(var x in Model.Courses){<option value="@x.Id">@x.Name</option>}</select></label><label>Nome da turma<input name="name" placeholder="Ex.: ADS 1A" required /></label><div class="form-row"><label>Série/semestre<input name="grade" placeholder="1º semestre" /></label><label>Turno<select name="shift"><option>Noturno</option><option>Matutino</option><option>Vespertino</option></select></label></div><div class="form-row"><label>Período<input name="academicTerm" placeholder="2026.2" /></label><label>Alunos<input name="studentCount" type="number" min="0" /></label></div><button class="btn btn-primary">Cadastrar turma</button></form>}</section><section class="list-card"><div class="list-title"><h2>Turmas cadastradas</h2><span>@Model.Classes.Count</span></div>@foreach(var item in Model.Classes){<article class="simple-row"><span>◫</span><div><strong>@item.Name</strong><small>@item.Course!.Name · @item.Grade · @item.Shift</small></div></article>}</section></div>
