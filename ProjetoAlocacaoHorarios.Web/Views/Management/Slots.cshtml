@model ProjetoAlocacaoHorarios.Web.Models.ManagementViewModel
@{ ViewData["Title"] = "Horários"; }
<partial name="_ManagementAlerts" /><div class="section-head"><a asp-action="Index">← Cadastros</a><p class="eyebrow">JANELAS DE AULA</p><h1>Slots de horário</h1><p>Somente os horários criados aqui podem receber uma aula.</p></div><div class="workspace-grid"><section class="form-card"><h2>Novo slot</h2><form asp-action="CreateSlot" method="post"><label>Dia da semana<select name="dayOfWeek"><option value="1">Segunda-feira</option><option value="2">Terça-feira</option><option value="3">Quarta-feira</option><option value="4">Quinta-feira</option><option value="5">Sexta-feira</option><option value="6">Sábado</option></select></label><div class="form-row"><label>Início<input name="startTime" type="time" required /></label><label>Duração (minutos)<input name="durationMinutes" type="number" value="50" min="30" max="300" required /></label></div><button class="btn btn-primary">Cadastrar slot</button></form></section><section class="list-card"><div class="list-title"><h2>Slots cadastrados</h2><span>@Model.Slots.Count</span></div>@foreach(var item in Model.Slots){<article class="simple-row"><span>◷</span><div><strong>@item.Label</strong><small>@item.DurationMinutes minutos</small></div><form asp-action="Delete" method="post"><input type="hidden" name="entity" value="slot"/><input type="hidden" name="id" value="@item.Id"/><button class="link-danger">Remover</button></form></article>}</section></div>
